{
  "name": "@karlangas12/mcp-auth-kit",
  "version": "1.0.1",
  "type": "module",
  "description": "Drop-in OAuthClientProvider wrapper for @modelcontextprotocol/sdk that fixes proactive token refresh, dynamic client registration retry, and trailing-slash resource normalization bugs seen across real MCP clients.",
  "license": "MIT",
  "author": "Carlos (Then Apply)",
  "homepage": "https://github.com/Karlangas12/mcp-auth-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karlangas12/mcp-auth-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Karlangas12/mcp-auth-kit/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "oauth2",
    "token-refresh",
    "dynamic-client-registration",
    "auth",
    "mcp-client",
    "mcp-oauth-trailing-slash",
    "mcp-dynamic-client-registration-retry"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
